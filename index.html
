<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fontavigo | Fontanería General en Vigo</title>
<meta name="description" content="Fontavigo: servicios de fontanería general en Vigo. Reparaciones, instalaciones, detección de fugas y urgencias. Llama al +34 654 963 258.">
<style>
:root{
  --primary:#0b6efd;
  --primary-dark:#0850c0;
  --dark:#0f1b2d;
  --text:#4a5568;
  --light:#f5f8fc;
  --white:#fff;
  --radius:14px;
  --shadow:0 10px 30px rgba(15,27,45,.08);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Segoe UI',system-ui,-apple-system,Roboto,Arial,sans-serif;color:var(--text);line-height:1.65;background:var(--white)}
a{text-decoration:none;color:inherit}
.container{width:min(1120px,92%);margin:0 auto}
header{position:sticky;top:0;background:rgba(255,255,255,.95);backdrop-filter:blur(8px);border-bottom:1px solid #e8eef6;z-index:100}
.nav{display:flex;align-items:center;justify-content:space-between;height:72px}
.logo{font-size:1.5rem;font-weight:800;color:var(--dark);letter-spacing:-.5px;display:flex;align-items:center;gap:8px}
.logo span{color:var(--primary)}
.logo svg{width:28px;height:28px;fill:var(--primary)}
nav ul{display:flex;gap:30px;list-style:none;align-items:center}
nav a{font-weight:500;font-size:.95rem;transition:.2s}
nav a:hover{color:var(--primary)}
.btn{display:inline-block;padding:13px 28px;border-radius:50px;font-weight:600;background:var(--primary);color:#fff;transition:.25s;border:2px solid var(--primary);cursor:pointer;font-size:1rem}
.btn:hover{background:var(--primary-dark);border-color:var(--primary-dark);transform:translateY(-2px)}
.btn.outline{background:transparent;color:var(--primary)}
.btn.outline:hover{background:var(--primary);color:#fff}
.btn.sm{padding:9px 20px;font-size:.9rem;color:#fff}
.hero{background:linear-gradient(135deg,#f5f8fc 0%,#e6f0ff 100%);padding:100px 0}
.hero-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:50px;align-items:center}
.tag{display:inline-block;background:#dbeafe;color:var(--primary-dark);padding:6px 16px;border-radius:50px;font-size:.85rem;font-weight:600;margin-bottom:20px}
h1{font-size:clamp(2.2rem,5vw,3.6rem);color:var(--dark);line-height:1.15;letter-spacing:-1px;margin-bottom:20px}
h1 span{color:var(--primary)}
.hero p{font-size:1.15rem;margin-bottom:32px;max-width:520px}
.hero-btns{display:flex;gap:14px;flex-wrap:wrap}
.hero-card{background:#fff;border-radius:24px;padding:36px;box-shadow:var(--shadow)}
.hero-card h3{color:var(--dark);margin-bottom:18px;font-size:1.2rem}
.hero-card li{list-style:none;padding:10px 0 10px 32px;position:relative;border-bottom:1px solid #eef2f7}
.hero-card li:last-child{border:none}
.hero-card li:before{content:"✓";position:absolute;left:0;color:#fff;background:var(--primary);width:22px;height:22px;border-radius:50%;font-size:.75rem;display:flex;align-items:center;justify-content:center;top:13px}
section{padding:90px 0}
.title{text-align:center;max-width:620px;margin:0 auto 55px}
.title h2{font-size:2.2rem;color:var(--dark);letter-spacing:-.5px;margin-bottom:12px}
.grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:26px}
.card{background:#fff;border:1px solid #e8eef6;border-radius:var(--radius);padding:32px;transition:.3s}
.card:hover{box-shadow:var(--shadow);transform:translateY(-5px);border-color:transparent}
.icon{width:54px;height:54px;border-radius:14px;background:#e6f0ff;display:flex;align-items:center;justify-content:center;font-size:1.6rem;margin-bottom:18px}
.card h3{color:var(--dark);margin-bottom:8px;font-size:1.15rem}
.alt{background:var(--light)}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.about h2{font-size:2.1rem;color:var(--dark);margin-bottom:16px}
.about p{margin-bottom:14px}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.stat{background:#fff;padding:30px 20px;border-radius:var(--radius);text-align:center;box-shadow:var(--shadow)}
.stat strong{display:block;font-size:2rem;color:var(--primary)}
.steps{counter-reset:s}
.step{text-align:center;padding:20px}
.step:before{counter-increment:s;content:counter(s);display:flex;margin:0 auto 16px;width:50px;height:50px;border-radius:50%;background:var(--primary);color:#fff;font-weight:700;align-items:center;justify-content:center;font-size:1.2rem}
.step h3{color:var(--dark);margin-bottom:6px}
.cta{background:var(--dark);color:#fff;text-align:center;border-radius:24px;padding:60px 30px}
.cta h2{font-size:2rem;margin-bottom:12px}
.cta p{color:#b8c4d6;margin-bottom:28px}
.contact-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:40px}
.info div{display:flex;gap:16px;margin-bottom:26px;align-items:flex-start}
.info .icon{margin:0;flex-shrink:0}
.info h4{color:var(--dark)}
form{background:#fff;padding:36px;border-radius:var(--radius);box-shadow:var(--shadow)}
input,textarea{width:100%;padding:14px 16px;border:1px solid #dce4ef;border-radius:10px;font-family:inherit;font-size:1rem;margin-bottom:16px;background:#fafcff}
input:focus,textarea:focus{outline:none;border-color:var(--primary)}
textarea{min-height:120px;resize:vertical}
form .btn{width:100%}
footer{background:var(--dark);color:#9fb0c7;padding:34px 0;text-align:center;font-size:.9rem}
footer strong{color:#fff}
@media(max-width:850px){
  .hero-grid,.about-grid,.contact-grid{grid-template-columns:1fr}
  nav ul li:not(:last-child){display:none}
  .hero{padding:60px 0}
  section{padding:65px 0}
}
</style>
</head>
<body>

